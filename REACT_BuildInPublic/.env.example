# ==============================================================================
# React Build in Public — Environment Configuration
# ==============================================================================
# Copy this file to .env before running local AI workflows or automated scheduling:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine & LLM Credentials (Optional for local agents)
# ------------------------------------------------------------------------------
# Primary Google Gemini API key (Used for post generation, humanizer, and reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fast inference fallback)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 2. LinkedIn & Publishing Bridge (Optional)
# ------------------------------------------------------------------------------
# Publora API Key (If scheduling posts directly via Publora API)
PUBLORA_API_KEY=your_publora_api_key_here

# Headless Puppeteer / Screenshot configuration
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true

# ------------------------------------------------------------------------------
# 3. Archify & Diagram Renderer Settings
# ------------------------------------------------------------------------------
# Path to Archify skill binary (if installed globally or in custom directory)
# Leave blank to use auto-discovery (~/.gemini/config/skills/archify or ~/.claude/skills/archify)
ARCHIFY_BIN_PATH=

# Preferred diagram theme preset: classic | signal-flow | blueprint | editorial
ARCHIFY_THEME_PRESET=classic
