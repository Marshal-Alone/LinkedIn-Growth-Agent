# ==============================================================================
# LinkedIn Growth Agent & Build-in-Public Suite — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the webapp or running agent skills:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Full-Stack WebApp & Server Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=*
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. AI Reasoning Engines & LLM Providers
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended for Antigravity, post composition, and skills)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (High-speed Llama 3 / Mixtral inference fallback)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 3. LinkedIn & Publishing Automation (Publora & Apify)
# ------------------------------------------------------------------------------
# Publora API Key — Sign up free at https://app.publora.com/signup (15 free posts/mo)
PUBLORA_API_KEY=sk_your_publora_key_here

# LinkedIn Platform Connection ID (format: linkedin-ABC123 from Publora Channels)
LINKEDIN_PLATFORM_ID=linkedin-your_id_here

# Apify Token (Optional) — Fetches post bodies, comment threads, and profiles without cookies
# Free tier gives $5/month at https://console.apify.com/sign-up
APIFY_TOKEN=apify_api_your_token_here

# Pixfaro Token (Optional) — Generates branded illustrations, quote cards, and carousels
# https://api.pixfaro.com/signup?ref=linkedin-skills
PIXFARO_TOKEN=pf_live_your_token_here

# ------------------------------------------------------------------------------
# 4. GitHub Integration (Build-in-Public Studio)
# ------------------------------------------------------------------------------
# Personal Access Token (classic or fine-grained) to inspect private/public repos & commits
GITHUB_TOKEN=ghp_your_github_token_here

# Default GitHub username to scan for build-log commits
GITHUB_DEFAULT_USER=Marshal-Alone

# ------------------------------------------------------------------------------
# 5. Archify Architecture Diagram Engine
# ------------------------------------------------------------------------------
# Optional custom binary path for Archify diagram generator
# Leave blank to use auto-discovery (~/.gemini/config/skills/archify or ~/.claude/skills/archify)
ARCHIFY_BIN_PATH=

# Diagram aesthetic preset: classic | signal-flow | blueprint | editorial
ARCHIFY_THEME_PRESET=classic
