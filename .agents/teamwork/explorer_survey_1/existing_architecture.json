  "cards": [
    {
      "dot": "cyan",
      "title": "1. Entry & Mounting",
      "items": [
        "Vite loads index.html with a single <div id=\"root\">",
        "main.jsx uses ReactDOM.createRoot() to mount App.jsx"
      ]
    },
    {
      "dot": "emerald",
      "title": "2. Components & Naming",
      "items": [
        "Components are JavaScript functions returning JSX",
        "Names MUST be PascalCase (<Button /> vs native <button>)"
      ]
    },
    {
      "dot": "rose",
      "title": "3. Single Return & Fragments",
      "items": [
        "A function can only return one single root element",
        "React Fragments (<> ... </>) group siblings without extra DOM divs"
      ]
    }
