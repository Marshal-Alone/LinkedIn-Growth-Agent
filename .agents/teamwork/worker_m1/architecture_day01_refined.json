  "cards": [
    {
      "dot": "cyan",
      "title": "1. Host DOM & Vite Mounting",
      "items": [
        "index.html provides a single empty host container: <div id=\"root\">",
        "main.jsx uses ReactDOM.createRoot() to mount <App /> into the host DOM"
      ]
    },
    {
      "dot": "emerald",
      "title": "2. Components & PascalCase",
      "items": [
        "Components are plain JavaScript functions that return JSX markup",
        "PascalCase (<Card />) tells JSX to invoke a component function vs lowercase native tag"
      ]
    },
    {
      "dot": "rose",
      "title": "3. Single Return & JSX Fragments",
      "items": [
        "Functions must return a single expression; JSX cannot return raw siblings",
        "React Fragments (<> ... </>) satisfy the single return rule without extra wrapper divs"
      ]
    }
  ]
